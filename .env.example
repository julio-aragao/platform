# Postgres (see docker-compose.yml)
DATABASE_URL=postgresql://aurora:aurora@localhost:5432/aurora

# API
API_PORT=4000
# Origin the browser uses (the web app proxies /api to the API, so cookies stay same-origin)
WEB_ORIGIN=http://localhost:3000
# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:3000

# Web
API_URL=http://localhost:4000
